# Cấu hình mẫu cho PostgreSQL; thay bằng thông tin cơ sở dữ liệu thực tế trong .env.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=growup
DB_USER=growup
DB_PASSWORD=
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_HOURS=12
COOKIE_SECURE=false

# AI provider configuration
AI_MODE=llm
AI_PROVIDER=openai
AI_FALLBACK_TO_DETERMINISTIC=true
AI_TIMEOUT_SECONDS=25
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=1800
AI_TEMPERATURE=0.2

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# NVIDIA NIM
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Assessment aggregation
MIN_RESPONSE_COUNT=5
MIN_RESPONSE_COVERAGE=0.30

# Lesson material upload
UPLOAD_MAX_MB=25
MATERIAL_STORAGE_DIR=storage/materials

# Teaching Agent limits
AGENT_MAX_STEPS=4
AGENT_MAX_HISTORY_MESSAGES=20
