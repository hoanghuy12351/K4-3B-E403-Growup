# Cấu hình mẫu cho PostgreSQL; thay bằng thông tin cơ sở dữ liệu thực tế trong .env.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=growup
DB_USER=growup
DB_PASSWORD=

# AI runtime: deterministic | llm | hybrid
AI_MODE=hybrid
# openai | gemini | nvidia
AI_PROVIDER=openai
AI_FALLBACK_TO_DETERMINISTIC=true
AI_TIMEOUT_SECONDS=25
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=1800
AI_TEMPERATURE=0.2
AI_MAX_HISTORICAL_QUESTIONS=20
AI_MAX_EVIDENCE_CHARS=300

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini Interactions API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# NVIDIA NIM OpenAI-compatible API
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_STYLE=chat_completions
